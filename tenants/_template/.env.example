# Copy to .env in this directory. Never commit .env; it is gitignored.
# harness/anthropic_client.py reads ANTHROPIC_API_KEY from the environment only.
ANTHROPIC_API_KEY=

# Cycle 20: publish (harness/publishers/shopify.py) + notifications
# (harness/notify.py). Every one of these is optional -- unset by default,
# and every code path that needs one fails closed with a clear message
# rather than making a call. Only read when tenant.yaml's `publisher:
# shopify` / `notifications.slack: true` / `notifications.email` turn on
# the channel that needs it.
SHOPIFY_STORE=
SHOPIFY_TOKEN=
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
NOTIFY_FROM=
