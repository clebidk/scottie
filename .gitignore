# Tenant run artifacts and secrets -- never committed.
tenants/*/out/
tenants/*/runs/
tenants/*/.env
tenants/*/fixtures/*.mov
tenants/*/fixtures/*.wav
tenants/*/fixtures/*.png
tenants/*/fixtures/*.jpg
tenants/*/inbox/*
!tenants/*/inbox/.gitkeep

# Cycle 27: harness brand import's working copy of whatever it downloaded/
# copied from a Drive folder or --local dir -- the classified/processed
# outputs (logo.*, fonts/, tokens.json, base.css, BRAND-IMPORT.md) are what
# gets committed, not the raw source files.
tenants/*/brand/incoming/

# Legacy top-level run dirs (pre-restructure); kept ignored so an old
# working copy does not suddenly show them as untracked.
out/
runs/
.env

# Local environments and vendored binaries. No trailing slash: on a deploy
# these are often symlinks into a shared checkout, and "vendor/" would not
# match a symlink.
.venv*/
vendor
models
__pycache__/
*.pyc
*.egg-info/
