  "review_quotes": [
    {
      "claim_id": "review-quote-1",
      "text": "I cannot say enough, how happy I am with the purchase of my peak sauna Fuji model! It is incredible craftsmanship, and fits perfectly in our garage where we get to use it almost daily! Through the entire process from initial purchase to post set up we have had outstanding customer service. The response time is incredibly fast and very supportive. I cannot recommend Peak Sauna highly enough!!!",
      "author": "Kristi W.",
      "date": "2026-07-25",
      "stars": 5,
      "product": "Peak Fuji"
    },
    {
      "claim_id": "review-quote-2",
      "text": "Assembly was very easy! We had a few questions and the customer support was second to none. Thanks Peak Sauna for a great experience. We love our Fuji!",
      "author": "David H.",
      "date": "2026-03-23",
      "stars": 5,
      "product": "Peak Fuji"
    },
    {
      "claim_id": "review-quote-3",
      "text": "Our experience with Peak Saunas has been very positive, from ordering, to installation, to putting our sauna to use. It warms up quickly and holds the temperature perfectly. Very easy and straightforward. The customer service has been very responsive and helpful. We are extremely satisfied.",
      "author": "Mike B.",
      "date": "2026-02-25",
      "stars": 5,
      "product": "Peak Fuji"
    },
    {
      "claim_id": "review-quote-4",
      "text": "Love our new Sauna. A great buying experience, customer support is outstanding from initial questions prior to ordering to a text on a Sunday to confirm a question about installation. My wife and I easily assembled the Sauna. Highly Recommend.",
      "author": "David C.",
      "date": "2025-11-18",
      "stars": 5,
      "product": "Peak Fuji"
    },
    {
      "claim_id": "review-quote-5",
      "text": "I am going on week four with my sauna! It has been everything I wanted, plus some. Customer service has also been incredible to work with. This sauna is definitely above and beyond. Thank you for all your help and meeting expectations.",
      "author": "Stacy H.",
      "date": "2025-08-25",
      "stars": 5,
      "product": "Peak Fuji"
    },
    {
      "claim_id": "review-quote-6",
      "text": "I was very pleased to accept delivery a few days ago. My Fuji sauna is excellent, high-quality and fairly easy to assemble. Any questions I had during the ordering process, delivery process, and assembly were addressed by staff with excellent customer service.",
      "author": "John H.",
      "date": "2025-08-03",
      "stars": 5,
      "product": "Peak Fuji"
    }
  ],
