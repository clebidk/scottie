{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "cartridges/listicle/skeletons/skeleton.schema.json",
  "title": "ListicleSkeleton",
  "description": "A winner skeleton: the item map of a proven listicle, adapted by the writer inside the listicle cartridge's fixed eight-section Structure. Never a claims source. Tenant-neutral: tenant fill hints live in tenants/<tenant>/listicle-library/skeletons.yaml.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "version",
    "name",
    "styles",
    "look",
    "sources",
    "tags",
    "item_count",
    "sections",
    "items",
    "headline_templates",
    "voice",
    "compliance",
    "writer_brief"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "styles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "enum": [
          "reasons",
          "mistakes",
          "questions",
          "myths",
          "tested"
        ]
      }
    },
    "look": {
      "type": "string",
      "enum": [
        "editorial",
        "cards",
        "pillars",
        "scorecard",
        "lander"
      ]
    },
    "look_note": {
      "type": "string",
      "minLength": 1
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "name"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "tenant_winner",
              "pattern",
              "swipe"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "url": {
            "type": "string",
            "pattern": "^https://"
          }
        }
      }
    },
    "tags": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "item_count": {
      "description": "The items in this skeleton's own item map (\"items\"): the count a run writes unless --items picks one of item_plans. Inside item_range.",
      "type": "integer",
      "minimum": 3,
      "maximum": 7
    },
    "item_range": {
      "description": "Cycle 100: [lo, hi], the item counts a page on this skeleton may have; the listicle item gate reads it. Absent: the cartridge's 5-7 (harness/listicle.py ITEM_COUNT_RANGE).",
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "integer",
        "minimum": 3,
        "maximum": 7
      }
    },
    "item_plans": {
      "description": "Cycle 100: the ordered item map for each other count inside item_range, keyed by the count (\"3\", \"4\"); the same shape as items.",
      "type": "object",
      "additionalProperties": {
        "$ref": "#/properties/items"
      }
    },
    "sections": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "hero",
        "items",
        "closing"
      ],
      "properties": {
        "hero": {
          "type": "string",
          "minLength": 1
        },
        "items": {
          "type": "string",
          "minLength": 1
        },
        "audience_fit": {
          "type": "string",
          "minLength": 1
        },
        "faq": {
          "type": "string",
          "minLength": 1
        },
        "closing": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 3,
      "maxItems": 7,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "role",
          "heading_hint",
          "image_role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$"
          },
          "heading_hint": {
            "type": "string",
            "minLength": 1
          },
          "image_role": {
            "type": "string",
            "enum": [
              "item",
              "lifestyle",
              "product",
              "install"
            ]
          }
        }
      }
    },
    "headline_templates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "voice": {
      "type": "string",
      "minLength": 1
    },
    "compliance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "writer_brief": {
      "type": "string",
      "minLength": 1
    }
  }
}
